PORT=5000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fastbuy_db

# Must be at least 16 chars in development, 32+ in production.
# Do NOT use placeholder values — generate a long random string.
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Optional: inbox for contact form submissions (defaults to EMAIL_USER)
CONTACT_EMAIL=hello@fastbuy.example

# Comma-separated allowed frontend origins.
# Required in production. In development, defaults to localhost:5500/5501 if omitted.
CLIENT_ORIGIN=http://localhost:5501,http://127.0.0.1:5501
